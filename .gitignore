# RTM generator backups / temp files and Excel lock files
docs/rtm/*.bak.xlsx
docs/rtm/*.xlsx.tmp
~$*
# Build output
target/
*.jar.original
.idea/
*.iml
.vscode/

# Local development credentials written by scripts/dev-user.sh
deploy/keycloak/.dev-user
# Python bytecode caches
__pycache__/
*.pyc

# Local platform administrator written during tests (scripts/platform-admin.sh)
deploy/keycloak/.platform-admin
