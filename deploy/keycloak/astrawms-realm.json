ermissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false,\"validations\":{\"pattern\":{\"pattern\":\"^[0-9]+(\\\\.[0-9]{1,2})?$\",\"error-message\":\"A non-negative amount\"}}}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
